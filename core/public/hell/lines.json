[
 {
  "i": 0,
  "start": 0.5,
  "end": 1.82,
  "text": "You died a minute ago."
 },
 {
  "i": 1,
  "start": 2.2,
  "end": 4.32,
  "text": "And two escorts are already at your door."
 },
 {
  "i": 2,
  "start": 4.54,
  "end": 6.93,
  "text": "One in white. One in black. Holding a chain."
 },
 {
  "i": 3,
  "start": 7.2,
  "end": 8.63,
  "text": "Forget the lake of fire."
 },
 {
  "i": 4,
  "start": 8.85,
  "end": 10.83,
  "text": "Chinese hell is a government office."
 },
 {
  "i": 5,
  "start": 11.05,
  "end": 12.66,
  "text": "Ten courts. Eighteen floors."
 },
 {
  "i": 6,
  "start": 12.88,
  "end": 15.59,
  "text": "A mirror that replays every lie you ever told."
 },
 {
  "i": 7,
  "start": 15.81,
  "end": 17.87,
  "text": "Serve your time. Cross the last bridge."
 },
 {
  "i": 8,
  "start": 18.09,
  "end": 20.11,
  "text": "An old woman hands you a bowl of soup."
 },
 {
  "i": 9,
  "start": 20.33,
  "end": 22.25,
  "text": "One sip, and you forget everything."
 },
 {
  "i": 10,
  "start": 22.47,
  "end": 23.47,
  "text": "So. Do you drink?"
 }
]